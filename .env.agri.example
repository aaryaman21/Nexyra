# Nexyra agricultural configuration template
DATABASE_URL=sqlite:///./nexyra.db
AGRISENSE_REGISTRY=ml/agri_artifacts
AGRISENSE_WORKSPACE=ml/agri_workspace

# Optional AGMARKNET configuration; keep empty until the exact official resource is verified.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=

# Next.js reads this on the server; scripts/run-dev.ps1 supplies the local API address.
NEXYRA_BACKEND_URL=http://127.0.0.1:8000
